{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"sourceMap": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"rootDir": "..",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": ["**/*.ts"]
}
